# 미설정 또는 빈 값이면 backend/data/team08.sqlite3 선택.
# 이 파일을 backend/.env로 복사해 로컬 설정 가능. 실행 환경변수가 우선.
DATABASE_URL=

# PostgreSQL 예시: 실제 비밀값은 .env에만 작성.
# DATABASE_URL=postgresql://username:password@localhost:5432/team08

# SQLite 상대 경로는 backend/ 기준.
# DATABASE_URL=sqlite:///data/team08.sqlite3

# 앱 시작 시 DB 연결 확인 제한 시간(초). 0 초과, 최대 120초.
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# 엔진 하나당 최대 5 + 5 = 10개 연결. 필요할 때만 생성.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# 모든 연결이 사용 중일 때 빈 연결을 기다리는 시간(초).
DATABASE_POOL_TIMEOUT_SECONDS=10
# 기존 연결을 빌릴 때 살아 있는지 확인.
DATABASE_POOL_PRE_PING=true

# 앱 로그 레벨: DEBUG / INFO / WARNING / ERROR / CRITICAL(대문자).
# Uvicorn 로그 레벨은 별도 --log-level 옵션으로 설정.
LOG_LEVEL=INFO

# 발급한 키는 실행 환경 또는 backend/.env에 설정. 루트 .env의 키도 fallback 지원.
# OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
